{
  "name": "vgmdb-node",
  "version": "1.0.0",
  "description": "TypeScript Node.js implementation of VGMdb API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "vgmdb",
    "api",
    "typescript",
    "music",
    "video-game-music"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.12.0",
    "cheerio": "^1.0.0-rc.12",
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "redis": "^4.6.11"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.25",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
